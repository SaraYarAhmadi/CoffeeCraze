{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/configs/*": ["./configs/*"],
      "@/models/*": ["./models/*"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
, "src/components/templates/product/Details.js", "src/app/page.js", "src/components/modules/navbar/Navbar.js", "src/components/templates/login-register/Login.js", "src/components/templates/login-register/Sms.js", "src/app/layout.tsx", "src/app/login-register/page.js", "src/components/modules/productCard/ProductCard.js", "src/app/wishList/page.js"  ],
  "exclude": [
    "node_modules"
  ]
}
